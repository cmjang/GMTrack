# Keep the data layout documentation in git while all local/generated payloads stay
# ignored. Each directory is re-ignored before its README is allowed back in.
!data/
data/*
!data/README.md
!data/datasets/
data/datasets/*
!data/datasets/README.md
!data/current/
data/current/*
!data/current/README.md
!data/test/
data/test/*
!data/test/README.md
scripts/slurm/
!scripts/slurm/
scripts/slurm/*
!scripts/slurm/.gitkeep
!scripts/slurm/train_stage1_v1_proxy.sbatch
!scripts/slurm/stratify_v1_proxy.sbatch
!scripts/slurm/train_stage2_gate_v1_proxy.sbatch
!scripts/slurm/train_stage2_diagnostic_v1_proxy.sbatch
!scripts/slurm/stratify_dong29999_probe.sbatch
!scripts/slurm/train_stage2_dong29999_probe.sbatch
!scripts/slurm/evaluate_dong29999_probe.sbatch
!scripts/slurm/train_stage1_causal.sbatch
!scripts/slurm/train_stage1_causal_heading.sbatch

# Agent instructions and the cluster job ledger -- local working files. The ledger
# records real Slurm job IDs, cluster paths and account names; none of that belongs in
# a published repository.
/CLAUDE.md
/AGENTS.md
/SLURM_JOBS.md

# Local paper PDFs -- kept out of the repository; download them from arXiv.
2601.23080v1.pdf
2607.20110v1.pdf

